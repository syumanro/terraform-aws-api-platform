version: 0.2

phases:
  #準備：aws cli確認→ecrログイン→イメージタグ作成
  pre_build:
    commands:
      - aws --version
      - aws ecr get-login-password --region "$AWS_DEFAULT_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
      - IMAGE_TAG="${CODEBUILD_RESOLVED_SOURCE_VERSION:0:12}"
      - IMAGE_URI="$ECR_REPOSITORY_URI:$IMAGE_TAG"
  #ビルド．テスト：dockerイメージ作成→コンテナ起動→HTTPテスト→削除
  build:
    commands:
      - docker build --tag "$IMAGE_URI" .
      - docker run --detach --name test-app --publish 8080:80 "$IMAGE_URI"
      - sleep 2
      - curl --fail --silent http://127.0.0.1:8080/health | grep --quiet '^OK$'
      - docker rm --force test-app
  #保存：ecrへプッシュ、imageDetail.json作成
  post_build:
    commands:
      - docker push "$IMAGE_URI"
      - printf '{"ImageURI":"%s"}' "$IMAGE_URI" > imageDetail.json
#成果物：後続のデプロイステージへファイルを渡す
artifacts:
  files:
    - appspec.yaml
    - taskdef.json
    - imageDetail.json
