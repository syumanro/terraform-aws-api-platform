{
  "family": "zhu-prd-ecs-test2",
  "executionRoleArn": "arn:aws:iam::043300555595:role/zhu-prd-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::043300555595:role/zhu-prd-ecs-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "zhu-prd-container-test2",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "cpu": 256,
      "memoryReservation": 512,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/zhu-prd-ecs-test2",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
